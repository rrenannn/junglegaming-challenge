{
  "realm": "jungle-gaming",
  "enabled": true,
  "displayName": "Jungle Gaming",
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "clientScopes": [
    {
      "name": "wagering.read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "wagering.write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "wallets.manage",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    }
  ],
  "clients": [
    {
      "clientId": "jungle-api",
      "name": "Jungle Gaming API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "provider-a",
      "name": "Provider A",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "provider-a-local-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["wagering.read", "wagering.write"],
      "protocolMappers": [
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-a",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        },
        {
          "name": "jungle-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "jungle-api",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "provider-b",
      "name": "Provider B",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "provider-b-local-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["wagering.read", "wagering.write"],
      "protocolMappers": [
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-b",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        },
        {
          "name": "jungle-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "jungle-api",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "wallet-service",
      "name": "Internal Wallet Service",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "wallet-service-local-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["wagering.read", "wallets.manage"],
      "protocolMappers": [
        {
          "name": "jungle-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "jungle-api",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
