APP_ENV=local
LOG_LEVEL=info
APP_PORT=8080
HTTP_ADDRESS=:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
READINESS_TIMEOUT=2s
SHUTDOWN_TIMEOUT=15s

POSTGRES_PORT=5432
DATABASE_URL=postgres://jungle_app:jungle-local-password@postgres:5432/jungle_gaming?sslmode=disable
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2

LOCALSTACK_PORT=4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=jungle-local
AWS_SECRET_ACCESS_KEY=jungle-local
SQS_ENDPOINT=http://localstack:4566
SQS_INPUT_QUEUE=wager-transactions.fifo
SQS_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wager-events.fifo

KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local-password
OIDC_ISSUER=http://keycloak:8080/realms/jungle-gaming
OIDC_AUDIENCE=jungle-api
PROVIDER_A_CLIENT_ID=provider-a
PROVIDER_A_CLIENT_SECRET=provider-a-local-secret
PROVIDER_B_CLIENT_ID=provider-b
PROVIDER_B_CLIENT_SECRET=provider-b-local-secret
INTERNAL_CLIENT_ID=wallet-service
INTERNAL_CLIENT_SECRET=wallet-service-local-secret
